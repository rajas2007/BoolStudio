{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BoolStudio",
  "version": "0.1.0",
  "identifier": "com.boolstudio.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BoolStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Interactive Boolean Algebra & Logic Circuit Engine",
    "longDescription": "BoolStudio is a high-performance desktop application for digital logic design, truth table generation, Karnaugh maps, and Boolean algebra simplification.",
    "publisher": "BoolStudio",
    "copyright": "Copyright © 2026 BoolStudio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
